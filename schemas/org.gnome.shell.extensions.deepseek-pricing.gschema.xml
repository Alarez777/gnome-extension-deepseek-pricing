<schemalist>
  <enum id="DeepSeekPricingModel">
    <value nick="flash" value="0"/>
    <value nick="pro" value="1"/>
  </enum>

  <enum id="DeepSeekPricingPanelMode">
    <value nick="icon" value="0"/>
    <value nick="status" value="1"/>
    <value nick="countdown" value="2"/>
  </enum>

  <enum id="DeepSeekPricingTimeFormat">
    <value nick="system" value="0"/>
    <value nick="12h" value="1"/>
    <value nick="24h" value="2"/>
  </enum>

  <enum id="DeepSeekPricingTerminology">
    <value nick="plain" value="0"/>
    <value nick="official" value="1"/>
  </enum>

  <enum id="DeepSeekPricingLanguage">
    <value nick="auto" value="0"/>
    <value nick="en" value="1"/>
    <value nick="es" value="2"/>
  </enum>

  <enum id="DeepSeekPricingDecimalSeparator">
    <value nick="auto" value="0"/>
    <value nick="point" value="1"/>
    <value nick="comma" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.deepseek-pricing"
          path="/org/gnome/shell/extensions/deepseek-pricing/">
    <key name="model" enum="DeepSeekPricingModel">
      <default>'flash'</default>
      <summary>Pricing model</summary>
      <description>Which DeepSeek model rates are shown in the menu.</description>
    </key>

    <key name="panel-mode" enum="DeepSeekPricingPanelMode">
      <default>'icon'</default>
      <summary>Panel display mode</summary>
      <description>Whether to show only the icon, the icon plus the current state, or the icon plus a countdown to the next price change.</description>
    </key>

    <key name="show-progress" type="b">
      <default>true</default>
      <summary>Show progress bar</summary>
      <description>Show a thin progress bar under the panel icon that fills as the current price tier elapses.</description>
    </key>

    <key name="time-format" enum="DeepSeekPricingTimeFormat">
      <default>'system'</default>
      <summary>Time format</summary>
      <description>Whether clock times follow the system clock format, or are forced to 12-hour or 24-hour format.</description>
    </key>

    <key name="terminology" enum="DeepSeekPricingTerminology">
      <default>'plain'</default>
      <summary>Terminology</summary>
      <description>Whether to use cheap/expensive or off-peak/peak labels.</description>
    </key>

    <key name="language" enum="DeepSeekPricingLanguage">
      <default>'auto'</default>
      <summary>Language</summary>
      <description>Language of the panel, menu and preferences. Automatic follows the system language and falls back to English.</description>
    </key>

    <key name="decimal-separator" enum="DeepSeekPricingDecimalSeparator">
      <default>'auto'</default>
      <summary>Decimal separator</summary>
      <description>Decimal separator used for prices. Automatic follows the region of the system language.</description>
    </key>
  </schema>
</schemalist>
