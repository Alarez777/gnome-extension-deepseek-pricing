{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
